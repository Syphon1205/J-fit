{
  "name": "j-fit",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "postinstall": "node scripts/patch-capacitor-health-ios.js",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "build": "expo export --platform web && node scripts/patch-web-output.js",
    "build:web": "expo export --platform web && node scripts/patch-web-output.js",
    "build:ios": "eas build --platform ios --profile production",
    "cap:add:ios": "cap add ios",
    "cap:sync:ios": "expo export --platform web && node scripts/patch-web-output.js && cap sync ios && node scripts/patch-capacitor-health-ios.js && node scripts/patch-capacitor-local-notifications-ios.js && node scripts/patch-capacitor-cordova-ios.js && node scripts/patch-trainer-proximity-ios.js",
    "cap:open:ios": "cap open ios",
    "cap:run:ios": "cap run ios",
    "build:android": "eas build --platform android --profile production",
    "desktop:build": "node scripts/build-trainer-macos.js",
    "desktop:run": "node scripts/build-trainer-macos.js --open",
    "desktop:dev": "swift run --package-path desktop/macos/CunninghamTrainer CunninghamTrainer"
  },
  "dependencies": {
    "@capacitor-community/apple-sign-in": "^7.1.0",
    "@capacitor/app": "^7.1.2",
    "@capacitor/camera": "^7.0.5",
    "@capacitor/core": "^7.4.2",
    "@capacitor/device": "^7.0.5",
    "@capacitor/geolocation": "^7.1.8",
    "@capacitor/haptics": "^7.0.5",
    "@capacitor/local-notifications": "^7.0.6",
    "@capacitor/preferences": "^7.0.4",
    "@capacitor/splash-screen": "^7.0.5",
    "@expo/metro-runtime": "~6.1.0",
    "@expo/vector-icons": "^15.0.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/native": "^7.1.8",
    "@react-navigation/native-stack": "^7.3.16",
    "capacitor-health": "^7.1.0",
    "expo": "~54.0.0",
    "expo-apple-authentication": "~8.0.8",
    "expo-auth-session": "~7.0.0",
    "expo-blur": "~15.0.8",
    "expo-camera": "~17.0.10",
    "expo-constants": "~18.0.0",
    "expo-image-picker": "~17.0.10",
    "expo-linear-gradient": "~15.0.0",
    "expo-linking": "~8.0.0",
    "expo-location": "~19.0.8",
    "expo-media-library": "^55.0.14",
    "expo-notifications": "~0.32.16",
    "expo-router": "~6.0.0",
    "expo-sensors": "~15.0.8",
    "expo-status-bar": "~3.0.0",
    "expo-updates": "~29.0.16",
    "expo-web-browser": "~15.0.0",
    "framer-motion": "^12.38.0",
    "lucide-react": "^1.14.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-maps": "1.20.1",
    "react-native-reanimated": "~4.1.0",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "^0.21.0",
    "recharts": "^3.8.1",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.2",
    "@capacitor/ios": "^7.4.2",
    "@types/react": "~19.1.0",
    "babel-preset-expo": "~54.0.0",
    "typescript": "~5.9.0"
  },
  "private": true
}
